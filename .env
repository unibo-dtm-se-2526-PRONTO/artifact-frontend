# Valori di default per lo sviluppo locale. Questo file È versionato.
#
# Le variabili con prefisso VITE_ finiscono nel bundle JavaScript servito al
# browser: sono pubbliche per definizione, quindi qui NON vanno mai segreti.
#
# Per sovrascrivere un valore sulla propria macchina, creare un ".env.local"
# (già ignorato da git tramite la regola "*.local").

# URL base del backend Django. Vale sia con il backend in Docker sia in locale,
# perché il container pubblica la porta 8000 sull'host.
VITE_API_URL=http://localhost:8000
